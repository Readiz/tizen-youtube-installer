<resources>
    <style name="AppTheme" parent="BaseAppTheme" />
    <style name="BaseAppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#136F63</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:buttonStyle">@style/ActionButton</item>
        <item name="android:borderlessButtonStyle">@style/IconActionButton</item>
        <item name="android:buttonBarButtonStyle">@style/ActionButton</item>
        <item name="android:alertDialogTheme">@style/AppDialogTheme</item>
    </style>
    <style name="AppDialogTheme" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#136F63</item>
        <item name="android:buttonBarButtonStyle">@style/ActionButton</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/PrimaryActionButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/ActionButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/TonalActionButton</item>
    </style>
    <style name="ActionButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/bg_action_button</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/action_button_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>
    <style name="PrimaryActionButton" parent="ActionButton">
        <item name="android:background">@drawable/bg_primary_button</item>
        <item name="android:textColor">@color/primary_button_text</item>
    </style>
    <style name="TonalActionButton" parent="ActionButton">
        <item name="android:background">@drawable/bg_tonal_button</item>
        <item name="android:textColor">@color/tonal_button_text</item>
    </style>
    <style name="IconActionButton" parent="ActionButton">
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:minWidth">48dp</item>
    </style>
</resources>
